# Only for an Apache whose document root is this repository rather than
# public/ — XAMPP at http://localhost/DayFlow, or shared hosting that cannot
# change it. Every request is served from public/, so nothing else in the
# repository (config, code, uploads, logs, .env, .git) can be reached by URL.
#
# The Docker image points Apache straight at public/ and never reads this.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # public/.htaccess takes over once the request is inside public/.
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite nothing here is safe to serve.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
