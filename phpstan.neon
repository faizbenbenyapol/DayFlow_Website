# Static analysis, also run in CI. Locally:
#   docker run --rm -v "$PWD":/app -w /app ghcr.io/phpstan/phpstan:2.2.16 analyse
parameters:
    level: 6
    phpVersion: 80200
    # Level 6 also asks what every array holds. Rows straight from PDO are
    # arrays of mixed, and writing array<string, mixed> on 200+ methods would
    # add noise, not knowledge; the shapes worth spelling out are written by
    # hand where they matter. Every parameter and return still needs a type.
    ignoreErrors:
        - identifier: missingType.iterableValue
    paths:
        - config
        - core
        - models
        - controllers
        - cron.php
        - public/index.php
        - scripts
    bootstrapFiles:
        - tests/phpstan/bootstrap.php
    # Set from the environment at runtime; their bootstrap values are not
    # the ones production sees, so no branch on them is "always" anything.
    dynamicConstantNames:
        - APP_ENV
        - APP_URL
        - DB_HOST
        - DB_NAME
        - DB_USER
        - DB_PASS
        - GOOGLE_CLIENT_ID
        - VAPID_PUBLIC_KEY
        - VAPID_PRIVATE_KEY
        - VAPID_SUBJECT
        - APP_KEY_ENV
        - CRON_TOKEN
        - MAX_UPLOAD_BYTES
        - TIMEZONE
