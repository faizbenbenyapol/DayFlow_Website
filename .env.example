APP_ENV=production
APP_URL=https://dayflow.example.com
DB_HOST=127.0.0.1
DB_NAME=dayflow
DB_USER=dayflow_app
DB_PASS=change-this-to-a-long-random-password
TIMEZONE=Asia/Bangkok
MAX_UPLOAD_BYTES=20971520
GOOGLE_CLIENT_ID=
APP_KEY=generate-a-64-character-hex-secret
CRON_TOKEN=generate-a-long-random-cron-secret

# Browser notifications (Web Push). Generate the pair once with:
#   php scripts/generate-vapid-keys.php
# Leaving these empty simply disables browser notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
MARIADB_DATABASE=dayflow
MARIADB_USER=dayflow_app
MARIADB_PASSWORD=change-this-to-a-long-random-password
MARIADB_ROOT_PASSWORD=change-this-to-another-long-random-password
DOMAIN=dayflow.example.com
